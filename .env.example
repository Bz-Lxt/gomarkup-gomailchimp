TZ=Asia/Shanghai
APP_ENV=dev
LOG_LEVEL=info

# JWT
JWT_SECRET=lumen-relay-dev-secret-change-me
JWT_ACCESS_TTL_MIN=120
JWT_REFRESH_TTL_H=168

# HMAC tracking
TRACK_HMAC_SECRET=lumen-track-hmac-dev-change-me
PUBLIC_TRACK_BASE=http://localhost:27483
PUBLIC_UNSUB_BASE=http://localhost:27485

# database
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen_dev_pw
POSTGRES_DB=lumen
DATABASE_URL=postgres://lumen:lumen_dev_pw@postgres:5432/lumen?sslmode=disable

# redis
REDIS_ADDR=redis:6379

# mail provider: smtp | ses | mock
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=false

# bounce source: smtp | imap | webhook | mock
BOUNCE_SOURCE=smtp

# ses (leave empty → UNVERIFIED)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# pipeline
SENDER_WORKERS=64
RATE_GMAIL_PER_MIN=120
RATE_OUTLOOK_PER_MIN=180
RATE_OTHER_PER_MIN=300
RATE_CHANNEL_PER_MIN=600
RATE_TENANT_PER_MIN=1000
